{
  "name": "@clevertap/faststore",
  "version": "1.0.0",
  "description": "CleverTap Web SDK integration for VTEX FastStore storefronts: loads the SDK, bridges FastStore analytics events to the CleverTap VTEX app event names, and identifies logged-in shoppers.",
  "keywords": [
    "clevertap",
    "faststore",
    "vtex",
    "analytics",
    "web-sdk"
  ],
  "author": "Jose Luis Duarte Mesa",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./runtime": "./dist/runtime.iife.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build-runtime.mjs && tsup",
    "test": "node scripts/build-runtime.mjs && vitest run",
    "typecheck": "node scripts/build-runtime.mjs && tsc --noEmit",
    "simulate": "node scripts/build-runtime.mjs && node scripts/simulate.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm build && node scripts/check-pack.mjs",
    "prepublishOnly": "pnpm verify"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
